# Copy to .env and edit.  Every script and the notebook read it (or the real environment).

# --- Which ApertureDB? -------------------------------------------------------------------
# Leave both unset to use the local Community Edition started by `docker compose up -d`.
# For a hosted/cloud instance (or any other ApertureDB) set a key - copy it from the instance's
# "Connect" -> "Generate API Key" page, or run `adb config get-key` for a CE you configured.
# APERTUREDB_KEY=
# or a JSON description:
# APERTUREDB_JSON={"host":"localhost","port":55557,"username":"admin","password":"admin","use_ssl":false}

# --- Which bucket folder? ------------------------------------------------------------------
GCS_BUCKET=
GCS_PREFIX=
# Label that scopes this run's data inside ApertureDB (default: <bucket>/<prefix>)
# DATASET_NAME=

# --- Object detector cut-off (proposals scoring below this are not stored) ----------------
# CONFIDENCE_THRESHOLD=0.5
