[
  {
    "FindEntity": {
      "_ref": 1,
      "with_class": "GCSLabel",
      "constraints": [
        "all",
        [
          "$description",
          "icontains",
          "animation"
        ],
        [
          "$score",
          ">=",
          0.5
        ]
      ]
    }
  },
  {
    "FindImage": {
      "is_connected_to": {
        "ref": 1
      },
      "blobs": true,
      "constraints": [
        "all",
        [
          "$adult_content_rank",
          "<=",
          1
        ],
        [
          "$violent_content_rank",
          "<=",
          1
        ],
        [
          "$face_count",
          ">=",
          1
        ],
        [
          "$min_face_joy",
          ">=",
          0.6
        ]
      ],
      "results": {
        "list": [
          "gcs_object_name",
          "face_count",
          "min_face_joy",
          "adult_content_likelihood",
          "violent_content_likelihood"
        ],
        "limit": 12
      },
      "sort": {
        "key": "face_count",
        "order": "descending"
      }
    }
  }
]
