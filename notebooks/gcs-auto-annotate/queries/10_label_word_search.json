[
  {
    "FindEntity": {
      "_ref": 1,
      "with_class": "GCSLabel",
      "constraints": [
        "all",
        [
          {
            "fulltext": [
              "$description",
              "animatd film",
              "any",
              {
                "mode": "adaptive",
                "max_edits": 1
              }
            ]
          },
          ">",
          0
        ],
        [
          "$score",
          ">=",
          0.5
        ]
      ]
    }
  },
  {
    "FindImage": {
      "is_connected_to": {
        "ref": 1
      },
      "blobs": false,
      "results": {
        "list": [
          "gcs_object_name",
          "label_count",
          "face_count"
        ],
        "limit": 12
      }
    }
  }
]
