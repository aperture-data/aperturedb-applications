[
  {
    "FindEntity": {
      "_ref": 1,
      "with_class": "GCSLabel",
      "constraints": [
        "all",
        [
          "$description",
          "icontains",
          "animation"
        ],
        [
          "$score",
          ">=",
          0.5
        ]
      ]
    }
  },
  {
    "FindImage": {
      "is_connected_to": {
        "ref": 1
      },
      "blobs": true,
      "constraints": [
        "all",
        [
          "$adult_content_rank",
          "<=",
          1
        ],
        [
          "$violent_content_rank",
          "<=",
          1
        ]
      ],
      "results": {
        "list": [
          "gcs_object_name",
          "adult_content_likelihood",
          "violent_content_likelihood"
        ],
        "limit": 12
      }
    }
  }
]
